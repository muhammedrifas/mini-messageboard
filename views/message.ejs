<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <header class="board-header">
      <h1 class="board-title">Message Details</h1>
      <a href="/" class="btn btn-secondary">← Back to Board</a>
    </header>

    <article class="message-card" style="padding: 2rem;">
      <div class="message-meta">
        <div class="avatar" style="width: 50px; height: 50px; font-size: 1.3rem;">
          <%= message.user.charAt(0) %>
        </div>
        <div class="meta-details">
          <span class="user-name" style="font-size: 1.15rem;"><%= message.user %></span>
          <time class="time-stamp"><%= new Date(message.added).toLocaleString() %></time>
        </div>
      </div>

      <p class="message-text" style="font-size: 1.2rem; margin: 1.5rem 0;">
        "<%= message.text %>"
      </p>
    </article>
  </main>
</body>
</html>